# Ollama Configuration
# When running locally: http://localhost:11434
# When running in Docker: http://ollama:11434 (set automatically by docker-compose)
OLLAMA_BASE_URL=http://localhost:11434

# LLM Model
# Recommended: qwen2.5:3b (good balance of speed and capability)
# Alternatives: qwen2.5:1.5b (faster, less capable), qwen2.5:7b (slower, more capable)
OLLAMA_MODEL=qwen2.5:3b

# Database Configuration
DATABASE_HOST=sqlite:///./db/library.db

# App Configuration
APP_PORT=8000
APP_HOST=0.0.0.0

# CORS (comma-separated origins, * for all)
CORS_ORIGINS=*

# LLM Settings
OLLAMA_TEMPERATURE=0
OLLAMA_NUM_PREDICT=2048

# Chat History (max messages to include in agent context)
MAX_CHAT_HISTORY=20
