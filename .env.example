# Ollama Configuration
# When running locally: http://localhost:11434
# When running in Docker: http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434

# LLM Model
# Recommended: qwen2.5:3b (good balance of speed and capability)
# Alternatives: qwen2.5:1.5b (faster, less capable), qwen2.5:7b (slower, more capable)
OLLAMA_MODEL=qwen2.5:3b

# Database Configuration
DATABASE_HOST=sqlite:///./db/library.db
